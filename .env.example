# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# --- Required -----------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key
# The Claude model id to use for analysis. Must support vision (page images).
ANTHROPIC_MODEL=your-claude-model-id

# --- Access control -----------------------------------------------------------
# Shared password for the web app. REQUIRED on Railway (the app stays locked without it);
# optional locally. Use a long random value and share it only with your team.
APP_PASSWORD=

# --- Model behaviour ------------------------------------------------------------
# Effort: low | medium | high | xhigh | max, or "omit" to send no effort setting
# (use omit for models that do not support the effort parameter).
TEN_EFFORT=high
# adaptive (recommended for current models) or omit.
TEN_THINKING=adaptive
# on: send the server-side refusal fallback ("fallbacks": "default"). Supported by
# current Opus/Fable models on the Claude API; set off if your model rejects it.
TEN_REFUSAL_FALLBACK=on
TEN_MAX_OUTPUT_TOKENS=48000
TEN_API_MAX_RETRIES=3
TEN_API_TIMEOUT_SECONDS=900

# --- Uploads and extraction -----------------------------------------------------
TEN_MAX_UPLOAD_MB=50
TEN_MAX_PAGES=120
# Pages rendered and sent as images for visual inspection (0 disables).
TEN_MAX_VISUAL_PAGES=40
TEN_VISUAL_WIDTH_PX=1280
# Tesseract language code(s) for OCR of scanned PDFs, e.g. eng or eng+deu.
TEN_OCR_LANGUAGE=eng

# --- Result emails (Resend) -----------------------------------------------------
# After every analysis the results (summary + PDFs) are emailed; failed analyses send a short notice.
# Get a key at https://resend.com/api-keys (a "Sending access" key is enough).
RESEND_API_KEY=
# auto: send when RESEND_API_KEY is set (default) | on | off
TEN_EMAIL_ENABLED=auto
# Comma-separated recipients.
TEN_EMAIL_TO=Info@tencapital.group
# REQUIRED for delivery to Info@tencapital.group: verify tencapital.group at https://resend.com/domains,
# then use a sender on it. Without this the app falls back to Resend's sandbox sender
# (onboarding@resend.dev), which only delivers to your Resend account's own email address.
TEN_EMAIL_FROM=TEN Capital Screening <screening@tencapital.group>
TEN_EMAIL_REPLY_TO=
# Attachments: review (Screening Review PDF), onepage, evidence (appendix PDF), json
TEN_EMAIL_ATTACH=review,onepage
TEN_EMAIL_ON_FAILURE=on

# --- Optional external research (disabled by default) -----------------------------
# When on, the UI toggle starts enabled. Only the company's public identity
# (name, website, sector, stage) is used as search context.
TEN_ENABLE_EXTERNAL_RESEARCH=off
TEN_WEB_SEARCH_TOOL=web_search_20260209
